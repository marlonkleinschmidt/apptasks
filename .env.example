# Copie para .env e ajuste conforme necessário.

# Segredo usado para assinar os tokens JWT da API.
JWT_SECRET=troque-este-valor-em-producao

# URL da API acessada pelo navegador (embutida no build do front).
# Em ambiente local, o padrão abaixo funciona porque a porta 3000 da API
# é publicada no host. Se mudar, refaça o build: docker compose build web
VITE_API_URL=http://localhost:3000/api

# Portas publicadas no host (mude se já estiverem em uso).
WEB_PORT=8080
API_PORT=3000
